pipeline {
    agent any

    tools {
        nodejs 'NodeJS-22'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        DEPLOYSAFE_API_URL = credentials('deploysafe-api-url')
        DEPLOYSAFE_API_TOKEN = credentials('deploysafe-api-token')
        DEPLOYSAFE_REPO = 'https://github.com/YUG-1092005/DeploySafe'
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                bat 'git rev-parse HEAD'
            }
        }

        stage('Install Frontend Dependencies') {
            steps {
                dir('frontend') {
                    bat 'npm ci'
                }
            }
        }

        stage('Install Backend Dependencies') {
            steps {
                dir('backend') {
                    bat 'npm ci'
                }
            }
        }

        stage('Build') {
            steps {
                dir('frontend') {
                    bat 'npm run build --if-present'
                }
                dir('backend') {
                    bat 'npm run build --if-present'
                }
            }
        }

        stage('Unit Tests') {
    steps {
        script {
            def testStatus = bat(
                script: 'cd Frontend && npm test',
                returnStatus: true
            )

            if (!fileExists('deploysafe-test-results.json')) {
                error('Vitest did not generate deploysafe-test-results.json')
            }

            def reportStatus = bat(
                script: 'node jenkins/scripts/check-test-results.mjs',
                returnStatus: true
            )

            if (reportStatus != 0) {
                error('Actual unit tests failed according to the Vitest JSON report.')
            }

            if (testStatus != 0) {
                echo 'Vitest returned a non-zero exit code, but the generated test report says all tests passed. Continuing based on the verified test report.'
            }
        }
    }
}

        stage('Coverage') {
            steps {
                script {
                    def hasCoverageScript = bat(
                        script: 'cd Frontend && node -e "const p=require(\'./package.json\'); process.exit(p.scripts && p.scripts[\'test:coverage\'] ? 0 : 1)"',
                        returnStatus: true
                    ) == 0

                    if (hasCoverageScript) {
                        bat 'cd Frontend && npm run test:coverage'
                    } else {
                        echo 'No test:coverage script configured; coverage will remain UNKNOWN.'
                    }
                }
            }
        }

        stage('Code Quality') {
            steps {
                script {
                    if (env.SONAR_HOST_URL?.trim() && env.SONAR_TOKEN?.trim()) {
                        echo 'SonarQube configuration detected.'
                    } else {
                        echo 'SonarQube is not configured; quality will be reported as UNKNOWN.'
                    }
                }
            }
        }

        stage('Security Scan') {
            steps {
                bat 'cd Frontend && npm audit --json > ..\\deploysafe-frontend-audit.json || exit /b 0'
                bat 'cd Backend && npm audit --json > ..\\deploysafe-backend-audit.json || exit /b 0'
            }
        }

        stage('Performance Test') {
            steps {
                script {
                    def hasLoadTest = bat(
                        script: 'cd Backend && node -e "const p=require(\'./package.json\'); process.exit(p.scripts && p.scripts[\'load:test\'] ? 0 : 1)"',
                        returnStatus: true
                    ) == 0

                    if (hasLoadTest) {
                        bat 'cd Backend && npm run load:test'
                    } else {
                        echo 'No Backend load:test script configured; p95 response time will remain UNKNOWN.'
                    }
                }
            }
        }

        stage('Collect Results') {
            steps {
                script {
                    def status = currentBuild.currentResult ?: 'SUCCESS'

                    withEnv([
                        "BUILD_STATUS=${status}",
                        "COVERAGE_FILE=frontend/coverage/coverage-summary.json",
                        "JEST_RESULTS_FILE=deploysafe-test-results.json"
                    ]) {
                        bat 'node jenkins/scripts/collect-metrics.mjs'
                    }
                }
            }
        }

        stage('Send Results to DeploySafe') {
            steps {
                script {
                    def duration = currentBuild.duration ? currentBuild.duration.intdiv(1000) : 0
                    def status = currentBuild.currentResult ?: 'SUCCESS'

                    withEnv([
                        "BUILD_DURATION_SECONDS=${duration}",
                        "BUILD_STATUS=${status}"
                    ]) {
                        bat 'node jenkins/scripts/send-results.mjs'
                    }
                }
            }
        }

        stage('Deployment Gate') {
            steps {
                bat 'node jenkins/scripts/evaluate-release.mjs'
            }
        }

        stage('Deploy') {
            when {
                expression {
                    fileExists('deploy.bat') || fileExists('deploy.cmd') || fileExists('deploy.ps1')
                }
            }
            steps {
                script {
                    if (fileExists('deploy.bat')) {
                        bat 'deploy.bat'
                    } else if (fileExists('deploy.cmd')) {
                        bat 'deploy.cmd'
                    } else {
                        bat 'powershell -ExecutionPolicy Bypass -File deploy.ps1'
                    }
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'deploysafe-*.json,deploysafe-*-audit.json', allowEmptyArchive: true
        }
    }
}
